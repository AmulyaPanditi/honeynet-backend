# ==========================================
# Honeynet Backend Environment Configuration
# ==========================================

# 1. Database Connection:
# Hosted PostgreSQL (production / shared team database):
# DATABASE_URL=postgresql://<username>:<password>@<db-host>:5432/<dbname>

# Local SQLite fallback (resolves deterministically to project root honeynet.db):
DATABASE_URL=sqlite:///./honeynet.db

# 2. Sensor Ingestion Authentication:
# Optional sensor API key for Cowrie honeypot forwarder.
# When set, requires 'X-API-Key' HTTP header on POST /api/events and POST /api/events/bulk.
# When left blank or unset, runs in open mode for local development.
# API_KEY=replace_with_secure_random_sensor_key
